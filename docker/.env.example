# Copy to `.env` (same dir as docker-compose.yaml) and fill in. `.env` is gitignored.

# OpenAI key Cognee uses for the LLM + embeddings (note: LLM_API_KEY, not OPENAI_API_KEY).
LLM_API_KEY=sk-...

# Host directory that holds (or will hold) Cognee's relational state under
# ~/.cognee. Defaults to ./cognee-state if unset. Point this at an existing
# ~/.cognee to preserve graphs when migrating from a host-side sidecar.
COGNEE_STATE_DIR=/home/youruser/.cognee

# Optional: pin specific users to an exact FalkorDB graph name (JSON object,
# keyed by email or email local-part). Useful to keep a graph name that was
# renamed out-of-band. Leave empty to use the COGNEE_GRAPH_NAME_FROM strategy.
# COGNEE_GRAPH_NAME_OVERRIDES={"will_agent_elizabeth": "elizabeth"}
